# ==========================================
# Variables de Entorno - Servicios Externos
# ==========================================

# --- API de Catálogo de Productos ---
# Endpoint base para el catálogo (por defecto utiliza https://dummyjson.com)
VITE_API_URL=https://dummyjson.com

# --- Firebase (Autenticación y Firestore) ---
# Obtén estas credenciales en Firebase Console: Configuración del proyecto > General > Tus apps > Web app
VITE_FIREBASE_API_KEY=tu_api_key_aqui
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto
VITE_FIREBASE_STORAGE_BUCKET=tu-proyecto.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# --- Base Path (Ruta de despliegue) ---
# Utilizado para GitHub Pages o despliegues en subrutas (ej: /myprojectapi12/ o /)
VITE_BASE_PATH=/
