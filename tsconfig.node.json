{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "composite": true,
    "isolatedModules": true,
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022"
  },
  "include": ["vite.config.js"]
}
